{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Static rotation edition catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/definitions/record"}}
  },
  "definitions": {
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,126}@v[1-9][0-9]{0,5}$"},
    "digest": {"type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$"},
    "audiences": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["ms3", "resident"]}},
    "locationKeys": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/key"}},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "record": {
      "type": "object",
      "required": ["key", "kind", "contentDigest", "audiences", "verifiedOn"],
      "properties": {
        "key": {"$ref": "#/definitions/key"}, "kind": {"enum": ["trainingLocation", "curatorProfile", "place", "officialLink", "phraseSet", "choice", "localPreset"]},
        "contentDigest": {"$ref": "#/definitions/digest"}, "audiences": {"$ref": "#/definitions/audiences"}, "verifiedOn": {"$ref": "#/definitions/date"}
      }
    },
    "localPlanV2": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "arrival": {"type": "object"}, "schedule": {"type": "object"}, "rounds": {"type": "object"}, "presentation": {"type": "object"},
        "documentation": {"type": "object"}, "attendance": {"type": "object"}, "feedback": {"type": "object"},
        "accessItems": {"type": "array", "maxItems": 12}, "contacts": {"type": "array", "maxItems": 12}, "checklistItems": {"type": "array", "maxItems": 24}, "resources": {"type": "array", "maxItems": 12}
      }
    }
  }
}
