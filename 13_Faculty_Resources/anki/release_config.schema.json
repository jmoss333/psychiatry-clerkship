{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://une-ms3-psychiatry.netlify.app/schemas/anki/release_config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalBaseUrl",
    "siteMode",
    "minimumSupportedDesktopAnki",
    "currentTestedAnki",
    "permanentIdentities",
    "coverage",
    "productionAllowlist",
    "releaseId",
    "releaseDate",
    "releaseEpoch",
    "templateVersions",
    "knownSafetyHolds",
    "frontJaccardReviewThreshold",
    "answerJaccardReviewThreshold",
    "duplicateNormalization",
    "sequenceMapPath",
    "primaryAuthorityPathPrefixes",
    "contextOnlyPathPrefixes",
    "sequencingOnlyPaths"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "canonicalBaseUrl": {"const": "https://une-ms3-psychiatry.netlify.app/"},
    "siteMode": {"enum": ["maintenance", "release"]},
    "minimumSupportedDesktopAnki": {"const": "23.10"},
    "currentTestedAnki": {"const": "26.5"},
    "permanentIdentities": {"$ref": "#/definitions/permanentIdentities"},
    "coverage": {"$ref": "#/definitions/coverage"},
    "productionAllowlist": {
      "type": "array",
      "const": [
        "psychiatry_clerkship_ms3_core.apkg",
        "psychiatry_clerkship_ms3_application.apkg",
        "psychiatry_clerkship_ms3_complete.apkg",
        "psychiatry_clerkship_qbank.apkg",
        "psychiatry_clerkship_ms3_cards.csv",
        "anki_release_receipt.json"
      ]
    },
    "releaseId": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "releaseDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {"type": "null"}
      ]
    },
    "releaseEpoch": {
      "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
    },
    "templateVersions": {"$ref": "#/definitions/templateVersions"},
    "knownSafetyHolds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/definitions/safetyHold"}
    },
    "frontJaccardReviewThreshold": {"const": 0.8},
    "answerJaccardReviewThreshold": {"const": 0.8},
    "duplicateNormalization": {"$ref": "#/definitions/duplicateNormalization"},
    "sequenceMapPath": {
      "const": "14_Tracks/MS3/Student_Ready_Pack/03_weekly_map/week_by_week_reading_map.md"
    },
    "primaryAuthorityPathPrefixes": {
      "type": "array",
      "const": [
        "02_Clinical_Skills/",
        "03_Core_Topics/",
        "04_Acute_and_Safety/",
        "05_Psychopharmacology/",
        "06_Family_and_Relational/",
        "07_Evidence_and_Reading/",
        "14_Tracks/MS3/Student_Ready_Pack/02_pocket_guides/",
        "14_Tracks/MS3/Student_Ready_Pack/04_expansion_modules/",
        "14_Tracks/MS3/Student_Ready_Pack/05_documentation_oral_presentation/"
      ]
    },
    "contextOnlyPathPrefixes": {
      "type": "array",
      "const": [
        "14_Tracks/MS3/Student_Ready_Pack/06_osce_cases/",
        "14_Tracks/MS3/Student_Ready_Pack/08_synthetic_cases/"
      ]
    },
    "sequencingOnlyPaths": {
      "type": "array",
      "const": [
        "14_Tracks/MS3/Student_Ready_Pack/03_weekly_map/week_by_week_reading_map.md",
        "09_Exam_Prep/Shelf_High_Yield/rapid_review_buzzwords.md",
        "14_Tracks/MS3/Student_Ready_Pack/core_reading_list.md",
        "14_Tracks/MS3/Student_Ready_Pack/07_shelf_guide/shelf_review_guide.md",
        "14_Tracks/MS3/Student_Ready_Pack/01_orientation/MS3_orientation_packet.md"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"siteMode": {"const": "maintenance"}}},
      "then": {
        "properties": {
          "releaseId": {"type": "null"},
          "releaseDate": {"type": "null"},
          "releaseEpoch": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"siteMode": {"const": "release"}}},
      "then": {
        "properties": {
          "releaseId": {
            "type": "string",
            "minLength": 1,
            "x-issue-code": "RELEASE_ID_REQUIRED"
          },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "x-issue-code": "RELEASE_DATE_REQUIRED"
          },
          "releaseEpoch": {
            "type": "integer",
            "minimum": 0,
            "x-issue-code": "RELEASE_EPOCH_REQUIRED"
          }
        }
      }
    }
