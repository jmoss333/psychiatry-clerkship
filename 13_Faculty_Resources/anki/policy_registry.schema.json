{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policies"],
  "properties": {
    "schemaVersion": {"const": 1},
    "policies": {
      "type": "array",
      "items": {"$ref": "#/definitions/policy"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "path", "anchor", "passageSha256", "reviewStatus"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "pattern": "^.*\\S.*$"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "anchor": {"type": "string", "pattern": "^.*\\S.*$"},
        "passageSha256": {"$ref": "#/definitions/sha256"},
        "reviewStatus": {"enum": ["unreviewed", "reviewed", "expired"]},
        "reviewedBy": {"type": "string", "pattern": "^.*\\S.*$"},
        "reviewedAt": {"type": "string", "format": "date"}
      },
      "allOf": [
        {
          "if": {"properties": {"reviewStatus": {"const": "reviewed"}}},
          "then": {"required": ["reviewedBy", "reviewedAt"]}
        }
      ]
    }
  }
}
