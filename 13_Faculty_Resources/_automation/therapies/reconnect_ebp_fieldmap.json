  "fieldMap": {
    "name": {
      "target": "id",
      "class": "V",
      "note": "slug of the upstream short name is the registry id (cbt, dbt, navigate-csc)"
    },
    "title": {
      "target": "fullName",
      "class": "V",
      "note": "the modality's expanded name"
    },
    "source": {
      "target": "evidence.guideline",
      "class": "V",
      "note": "the guideline or registry the grade comes from (e.g. 'NICE NG222'); must resolve to a real, current document — the therapy analogue of the pharmacy's DailyMed label"
    },
    "evidence_level": {
      "target": "evidence.level",
      "class": "V",
      "note": "ReConnect's I–IV grade, verified against the cited guideline's own recommendation strength; shown with the guideline named, never re-graded"
    },
    "typical_sessions": {
      "target": "format.typicalSessions",
      "class": "V",
      "note": "a count or range as the manual/guideline states it"
    },
    "session_format": {
      "target": "format.modalities",
      "class": "V",
      "note": "Individual / Group / Family / Telehealth as the manual states"
    },
    "symptom_cluster": {
      "target": "domain",
      "class": "R",
      "note": "ReConnect cluster vocabulary; map to library topic slugs at authoring"
    },
    "target_audience": {
      "target": "audienceTier",
      "class": "R"
    },
    "safety_tier": {
      "target": "safetyTier",
      "class": "R"
    },
    "key_components": {
      "target": "description.keyComponents",
      "class": "J-seed",
      "note": "the mechanism line; upstream text embeds outcome claims ('60-70% response') that need their own evidenceIds before shipping"
    },
    "when_to_use": {
      "target": "guidance.whenToUse",
      "class": "J-seed",
      "note": "indication prose; re-authored under faculty review, quoted only from attested pages"
    },
    "contraindications_cautions": {
      "target": "guidance.cautions",
      "class": "J-seed",
      "note": "safety-bearing prose: J under review, never carried verbatim"
    },
    "_stale": {
      "target": null,
      "class": "meta"
    },
    "audience": {
      "target": null,
      "class": "meta",
      "note": "free-text duplicate of target_audience"
    },
    "content_type": {
      "target": null,
      "class": "meta",
      "note": "always 'evidence_based_practice'"
