{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReConnect snapshot provenance inventory",
  "description": "Strict, read-only provenance for ReConnect material retained in the clerkship source tree: byte-identical snapshots (relation exact-copy, keyed by snapshotPath) and registries derived from a ReConnect dataset at a pinned revision (relation derived, keyed by derivedPath, with a required fieldMap).",
  "type": "object",
  "required": ["schemaVersion", "description", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "if": { "required": ["snapshotPath"] },
        "then": { "$ref": "#/definitions/exactCopy" },
        "else": { "$ref": "#/definitions/derived" }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "sourceRepository": {
      "const": "https://github.com/jmoss333/reconnect-psychiatry-system.git"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exactCopy": {
      "type": "object",
      "required": [
        "snapshotPath",
        "snapshotSha256",
        "sourceRepository",
        "sourcePath",
        "sourceRevision",
        "sourceSha256",
        "relation",
        "clinicalReviewRequired",
        "syncPolicy"
      ],
      "properties": {
        "snapshotPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\r\\n])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?:[^/]+/)*_source/(?:[^/]+/)*[^/]+$"
        },
        "snapshotSha256": { "$ref": "#/definitions/sha256" },
        "sourceRepository": { "$ref": "#/definitions/sourceRepository" },
        "sourcePath": { "$ref": "#/definitions/sourcePath" },
        "sourceRevision": { "$ref": "#/definitions/sourceRevision" },
        "sourceSha256": { "$ref": "#/definitions/sha256" },
        "relation": { "const": "exact-copy" },
        "clinicalReviewRequired": { "const": true },
        "syncPolicy": { "const": "manual-reviewed-only" }
      },
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "required": [
        "derivedPath",
        "dataset",
        "sourceRepository",
        "sourcePath",
        "sourceRevision",
        "sourceSha256",
        "sourceRecords",
        "fieldMap",
        "relation",
        "clinicalReviewRequired",
        "syncPolicy"
      ],
      "properties": {
        "derivedPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*[\\r\\n])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?:[^/]+/)*[^/]+\\.json$"
        },
        "dataset": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        },
        "sourceRepository": { "$ref": "#/definitions/sourceRepository" },
        "sourcePath": { "$ref": "#/definitions/sourcePath" },
        "sourceRevision": { "$ref": "#/definitions/sourceRevision" },
        "sourceSha256": { "$ref": "#/definitions/sha256" },
        "sourceRecords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "fieldMap": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            ]
          }
        },
        "relation": { "const": "derived" },
        "clinicalReviewRequired": { "const": true },
        "syncPolicy": { "const": "manual-reviewed-only" }
      },
      "additionalProperties": false
    }
  }
}
