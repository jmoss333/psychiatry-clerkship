{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pairings.schema.json",
  "title": "Pairings registry",
  "description": "Topic-keyed pairings joining a topic page, a deployed audio_oe brief, a practice tool, and (P2 only) an external book/audiobook/podcast, injected into the six week pages at build time.",
  "type": "object",
  "required": ["pairings"],
  "additionalProperties": false,
  "properties": {
    "_note": { "type": "string" },
    "renderMode": {
      "description": "collapsible = <details> collapsed by default (faculty decision 2026-09-04, to keep the week pages uncluttered); open = always-expanded block.",
      "type": "string",
      "enum": ["collapsible", "open"]
    },
    "pairings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/pairing" }
    }
  },
  "definitions": {
    "pairing": {
      "type": "object",
      "required": ["id", "topic", "weeks", "audiences", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^pair_[a-z0-9_]+$" },
        "topic": { "type": "string", "minLength": 2, "maxLength": 80 },
        "blurb": { "type": "string", "maxLength": 200 },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 6 }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["ms3", "res"] }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["role", "kind"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["read", "listen", "practice", "deeper"] },
        "kind": { "type": "string", "enum": ["page", "tool", "audio_oe", "book", "audiobook", "podcast"] },
        "ref": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "show": { "type": "string", "minLength": 1 },
        "episode": { "type": "string", "minLength": 1 },
        "isbn13": { "type": "string", "pattern": "^97[89][0-9]{10}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "note": { "type": "string", "maxLength": 200 },
        "verifiedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "verifiedBy": { "type": "string", "enum": ["search-attested", "opened"] }
      },
      "allOf": [
        {
          "description": "Internal kinds are resolved by ref against a shipped registry.",
          "if": { "properties": { "kind": { "enum": ["page", "tool", "audio_oe"] } } },
          "then": { "required": ["ref"] }
        },
        {
          "description": "External kinds carry a verification stamp so link quality is queryable data, not a caveat in prose.",
          "if": { "properties": { "kind": { "enum": ["book", "audiobook", "podcast"] } } },
          "then": { "required": ["verifiedOn", "verifiedBy"] }
        }
      ]
    }
  }
}
