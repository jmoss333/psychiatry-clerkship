{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clerkship crisis-resource snapshot",
  "description": "Verified crisis contacts that the build renders into a single shared block. Derived from the ReConnect Psychiatry System crisis dataset and independently re-verified against official sources.",
  "type": "object",
  "required": ["schemaVersion", "description", "provenance", "unitEscalationNote", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "unitEscalationNote": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "required": [
        "upstreamRepository",
        "upstreamPath",
        "upstreamField",
        "relation",
        "syncPolicy",
        "syncTool",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "upstreamRepository": {
          "const": "https://github.com/jmoss333/reconnect-psychiatry-system.git"
        },
        "upstreamPath": { "type": "string", "minLength": 1 },
        "upstreamField": { "type": "string", "minLength": 1 },
        "relation": { "const": "derived-and-independently-verified" },
        "syncPolicy": { "const": "manual-reviewed-only" },
        "syncTool": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "upstreamFreshnessCaveat": { "type": "string", "minLength": 1 }
      }
    },
    "upstreamDiscrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reconnectRecord",
          "upstreamValue",
          "verifiedValue",
          "verificationSource",
          "verifiedOn",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "reconnectRecord": { "type": "string", "minLength": 1 },
          "upstreamValue": { "type": "string", "minLength": 1 },
          "verifiedValue": { "type": "string", "minLength": 1 },
          "verificationSource": { "type": "string", "format": "uri", "pattern": "^https://" },
          "verifiedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "contact",
          "availability",
          "scope",
          "verificationSource",
          "verifiedOn"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "contact": { "type": "string", "minLength": 1 },
          "alsoAvailable": { "type": "string", "minLength": 1 },
          "availability": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["national", "maine"] },
          "verificationSource": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "Official source for this contact. Must be the operating organization or a government page, never a third-party aggregator."
          },
          "verifiedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date the contact was last checked against verificationSource. Drives the 'verified' line in the rendered block; never build time, so output stays byte-reproducible."
          },
          "reconnectRecord": {
            "type": "string",
            "minLength": 1,
            "description": "Corresponding record in the upstream ReConnect crisis dataset, for traceability during a sync."
          }
        }
      }
    }
  }
}
