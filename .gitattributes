# Git LFS — binary assets the BUILT sites need at deploy time.
# The clerkship sites embed audio (landmark-trial overviews + NotebookLM briefs). For deploy-on-push
# to work, these must reach the Netlify build, so track them with LFS instead of gitignoring them.
# Activate with: git lfs install  (then see GIT_AND_DEPLOY_PLAN.md §6 for the migration sequence).
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Normalize line endings for text (belt-and-suspenders with core.autocrlf=false).
*.md   text
*.html text
*.py   text
*.json text
