{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topic_meta",
  "description": "Structured topic-template metadata for the clerkship SPA. Keys are '<topic>.md' plus a leading '_note'. The enforced check is 13_Faculty_Resources/_automation/validate_topic_meta.py; this schema documents the shape for editors.",
  "type": "object",
  "properties": { "_note": { "type": "string" } },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "read": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
      "hy": { "type": "boolean" },
      "tldr": { "type": "string" },
      "points": { "type": "array", "items": { "type": "string" } },
      "cant": { "type": "string" },
      "ruleOut": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "firstMove": { "type": "string" },
      "quiz": {
        "type": "object",
        "required": ["q", "o", "why"],
        "properties": {
          "q": { "type": "string" },
          "why": { "type": "string" },
          "o": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["t"],
              "properties": { "t": { "type": "string" }, "c": { "type": "boolean" } }
            }
          }
        }
      },
      "cta": {},
      "evidenceIds": { "type": "array", "items": { "type": "string" } },
      "relatedTools": { "type": "array", "items": { "type": "string" } },
      "workflowModes": { "type": "array", "items": { "type": "string" } },
      "workflowStages": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["encounter", "diagnosis", "safety", "treatment", "communication", "family", "team", "exam"]
        }
      },
      "clinicalWorkflow": {
        "type": "object",
        "properties": {
          "ask": { "type": "string" },
          "mse": { "type": "string" },
          "safety": { "type": "string" },
          "say": { "type": "string" },
          "collateral": { "type": "string" },
          "rounds": { "type": "string" },
          "exam": { "type": "string" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string" },
                "href": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "familyOverlay": { "type": "string" },
      "communicationCases": { "type": "array", "items": { "type": "string" } },
      "safetyLevel": { "type": "string", "enum": ["low", "moderate", "high"] },
      "safetySteps": {
        "type": "array",
        "minItems": 3,
        "maxItems": 5,
        "items": { "type": "string", "minLength": 1 }
      },
      "safetyDoc": { "type": "string", "minLength": 1 },
      "facultyReview": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["draft", "pending", "reviewed", "retired"] },
          "reviewer": { "type": "string" },
          "lastReviewed": { "type": "string" }
        }
      }
    },
    "dependencies": { "firstMove": ["ruleOut"] }
  }
}
