{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Attending-curated rotation edition v2",
  "type":"object","additionalProperties":false,"required":["format","schemaVersion","config","digest"],
  "properties":{
    "format":{"const":"cw-rotation-edition"},
