    "config":{"$ref":"#/definitions/configV2"},
    "digest":{"$ref":"#/definitions/digest"}
  },
  "definitions":{
    "key":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,126}@v[1-9][0-9]{0,5}$"},
    "digest":{"type":"string","pattern":"^sha256-[A-Za-z0-9_-]{43}$"},
    "revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "time":{"type":"string","pattern":"^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "coreInstanceId":{"type":"string","minLength":8,"maxLength":160,"pattern":"^core:[\\x21-\\x7e]+:[1-9][0-9]*$"},
    "localScheduleId":{"type":"string","maxLength":160,"pattern":"^local:schedule:[1-9][0-9]*$"},
    "localAccessId":{"type":"string","maxLength":160,"pattern":"^local:access:[1-9][0-9]*$"},
    "localContactId":{"type":"string","maxLength":160,"pattern":"^local:contact:[1-9][0-9]*$"},
    "localChecklistId":{"type":"string","maxLength":160,"pattern":"^local:checklist:[1-9][0-9]*$"},
    "localResourceId":{"type":"string","maxLength":160,"pattern":"^local:resource:[1-9][0-9]*$"},
    "coreRef":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[\\x21-\\x7e]+$","not":{"$ref":"#/definitions/key"}},
    "priority":{"enum":["required","recommended","optional"]},
    "context":{"type":"object","additionalProperties":false,"required":["trainingLocationKey","curatorProfileKey","rotationStart","rotationEnd","editionCheckedOn"],"properties":{"trainingLocationKey":{"$ref":"#/definitions/key"},"curatorProfileKey":{"$ref":"#/definitions/key"},"rotationStart":{"$ref":"#/definitions/date"},"rotationEnd":{"$ref":"#/definitions/date"},"editionCheckedOn":{"$ref":"#/definitions/date"}}},
    "pathItem":{"type":"object","additionalProperties":false,"required":["instanceId","ref","week","order","priority"],"properties":{"instanceId":{"$ref":"#/definitions/coreInstanceId"},"ref":{"$ref":"#/definitions/coreRef"},"week":{"type":"integer","minimum":1,"maximum":6},"order":{"type":"integer","minimum":1,"maximum":96},"priority":{"$ref":"#/definitions/priority"},"reasonKey":{"$ref":"#/definitions/key"}}},
    "changeSummary":{"type":"object","additionalProperties":false,"required":["kindCodes","changedItemCount"],"properties":{"kindCodes":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"enum":["initial","edition-context","curriculum-selection","curriculum-priority","curriculum-reason","schedule","arrival","workflow","access","contacts","checklist","resources"]}},"changedItemCount":{"type":"integer","minimum":0,"maximum":255}}},
    "configV2":{"type":"object","additionalProperties":false,"required":["audience","pathId","editionNumber","createdAgainstCoreRevision","createdAgainstLocalCatalogRevision","context","phraseSetKey","pathItems","localPlan","changeSummary"],"properties":{"audience":{"enum":["ms3","resident"]},"pathId":{"enum":["ms3-six-week","resident-four-week"]},"editionNumber":{"type":"integer","minimum":1,"maximum":2147483647},"createdAgainstCoreRevision":{"$ref":"#/definitions/revision"},"createdAgainstLocalCatalogRevision":{"$ref":"#/definitions/digest"},"context":{"$ref":"#/definitions/context"},"phraseSetKey":{"$ref":"#/definitions/key"},"pathItems":{"type":"array","minItems":1,"maxItems":96,"items":{"$ref":"#/definitions/pathItem"}},"localPlan":{"$ref":"#/definitions/localPlanV2"},"changeSummary":{"$ref":"#/definitions/changeSummary"}},"oneOf":[{"properties":{"audience":{"const":"ms3"},"pathId":{"const":"ms3-six-week"}}},{"properties":{"audience":{"const":"resident"},"pathId":{"const":"resident-four-week"},"pathItems":{"items":{"allOf":[{"$ref":"#/definitions/pathItem"},{"properties":{"week":{"maximum":4}}}]}},"localPlan":{"properties":{"resources":{"items":{"allOf":[{"$ref":"#/definitions/resource"},{"properties":{"week":{"maximum":4}}}]}}}}}}]},
    "arrival":{"type":"object","additionalProperties":false,"required":["timingCode","time","placeKey","checkInRoleKey"],"properties":{"timingCode":{"enum":["at","by"]},"time":{"$ref":"#/definitions/time"},"placeKey":{"$ref":"#/definitions/key"},"checkInRoleKey":{"$ref":"#/definitions/key"},"linkKey":{"$ref":"#/definitions/key"}}},
    "scheduleEvent":{"type":"object","additionalProperties":false,"required":["instanceId","daySetKey","startTime","activityKey","priority"],"properties":{"instanceId":{"$ref":"#/definitions/localScheduleId"},"daySetKey":{"$ref":"#/definitions/key"},"startTime":{"$ref":"#/definitions/time"},"endTime":{"$ref":"#/definitions/time"},"activityKey":{"$ref":"#/definitions/key"},"placeKey":{"$ref":"#/definitions/key"},"priority":{"$ref":"#/definitions/priority"}}},
    "schedule":{"type":"object","additionalProperties":false,"required":["dayStart","dayEnd","endQualifierCode","events"],"properties":{"dayStart":{"$ref":"#/definitions/time"},"dayEnd":{"$ref":"#/definitions/time"},"endQualifierCode":{"enum":["at","about","no-later-than"]},"events":{"type":"array","minItems":1,"maxItems":24,"items":{"$ref":"#/definitions/scheduleEvent"}}}},
    "rounds":{"type":"object","additionalProperties":false,"required":["preparationKey","participationKey","followUpKey"],"properties":{"preparationKey":{"$ref":"#/definitions/key"},"participationKey":{"$ref":"#/definitions/key"},"followUpKey":{"$ref":"#/definitions/key"}}},
    "presentation":{"type":"object","additionalProperties":false,"required":["formatKey","timingKey","elementKeys"],"properties":{"formatKey":{"$ref":"#/definitions/key"},"timingKey":{"$ref":"#/definitions/key"},"elementKeys":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/definitions/key"}}}},
    "documentation":{"type":"object","additionalProperties":false,"required":["workflowKey","timingKey"],"properties":{"workflowKey":{"$ref":"#/definitions/key"},"timingKey":{"$ref":"#/definitions/key"},"policyLinkKey":{"$ref":"#/definitions/key"}}},
    "attendance":{"type":"object","additionalProperties":false,"required":["eventInstanceIds","absenceRoleKey"],"properties":{"eventInstanceIds":{"type":"array","minItems":1,"maxItems":24,"uniqueItems":true,"items":{"$ref":"#/definitions/localScheduleId"}},"absenceRoleKey":{"$ref":"#/definitions/key"},"policyLinkKey":{"$ref":"#/definitions/key"}}},
    "feedback":{"type":"object","additionalProperties":false,"required":["cadenceKey","initiatorKey","settingKey"],"properties":{"cadenceKey":{"$ref":"#/definitions/key"},"initiatorKey":{"$ref":"#/definitions/key"},"settingKey":{"$ref":"#/definitions/key"}}},
    "accessItem":{"type":"object","additionalProperties":false,"required":["instanceId","itemKey","dueKey"],"properties":{"instanceId":{"$ref":"#/definitions/localAccessId"},"itemKey":{"$ref":"#/definitions/key"},"dueKey":{"$ref":"#/definitions/key"},"linkKey":{"$ref":"#/definitions/key"}}},
    "contact":{"type":"object","additionalProperties":false,"required":["instanceId","roleKey"],"properties":{"instanceId":{"$ref":"#/definitions/localContactId"},"roleKey":{"$ref":"#/definitions/key"},"linkKey":{"$ref":"#/definitions/key"}}},
    "checklistItem":{"type":"object","additionalProperties":false,"required":["instanceId","itemKey","priority"],"properties":{"instanceId":{"$ref":"#/definitions/localChecklistId"},"itemKey":{"$ref":"#/definitions/key"},"priority":{"$ref":"#/definitions/priority"}}},
    "resource":{"type":"object","additionalProperties":false,"required":["instanceId","linkKey","priority","week"],"properties":{"instanceId":{"$ref":"#/definitions/localResourceId"},"linkKey":{"$ref":"#/definitions/key"},"priority":{"$ref":"#/definitions/priority"},"week":{"type":"integer","minimum":1,"maximum":6},"reasonKey":{"$ref":"#/definitions/key"}}},
    "localPlanV2":{"type":"object","additionalProperties":false,"properties":{"arrival":{"$ref":"#/definitions/arrival"},"schedule":{"$ref":"#/definitions/schedule"},"rounds":{"$ref":"#/definitions/rounds"},"presentation":{"$ref":"#/definitions/presentation"},"documentation":{"$ref":"#/definitions/documentation"},"attendance":{"$ref":"#/definitions/attendance"},"feedback":{"$ref":"#/definitions/feedback"},"accessItems":{"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/definitions/accessItem"}},"contacts":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/definitions/contact"}},"checklistItems":{"type":"array","minItems":1,"maxItems":24,"items":{"$ref":"#/definitions/checklistItem"}},"resources":{"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/definitions/resource"}}}}
  }
