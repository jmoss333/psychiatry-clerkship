{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attending-curated rotation edition",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "config", "digest"],
  "properties": {
    "format": {"const": "cw-rotation-edition"},
    "schemaVersion": {"const": 1},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "pathId",
        "editionNumber",
        "createdAgainstCoreRevision",
        "card",
        "pathItems",
        "localOrientation",
        "changeNote"
      ],
      "properties": {
        "audience": {"type": "string"},
        "pathId": {"type": "string"},
        "editionNumber": {"type": "integer", "minimum": 1},
        "createdAgainstCoreRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "card": {"$ref": "#/definitions/card"},
        "pathItems": {
          "type": "array",
          "items": {"$ref": "#/definitions/pathItem"}
        },
        "localOrientation": {"$ref": "#/definitions/localOrientation"},
        "changeNote": {"$ref": "#/definitions/rationale"}
      },
      "oneOf": [
        {
          "properties": {
            "audience": {"const": "ms3"},
            "pathId": {"const": "ms3-six-week"},
            "pathItems": {
              "type": "array",
              "items": {"$ref": "#/definitions/ms3PathItem"}
            },
            "localOrientation": {
              "properties": {
                "resources": {
                  "type": "array",
                  "items": {"$ref": "#/definitions/ms3Resource"}
                }
              }
            }
          }
        },
        {
          "properties": {
            "audience": {"const": "resident"},
            "pathId": {"const": "resident-four-week"},
            "pathItems": {
              "type": "array",
              "items": {"$ref": "#/definitions/residentPathItem"}
            },
            "localOrientation": {
              "properties": {
                "resources": {
                  "type": "array",
                  "items": {"$ref": "#/definitions/residentResource"}
                }
              }
            }
          }
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    }
  },
  "definitions": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 0,
      "maxLength": 280
    },
    "orientationText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 600
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "identifier": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "priority": {
      "type": "string",
      "enum": ["required", "recommended", "optional"]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "locationName",
        "locationCode",
        "curatorName",
        "curatorRole",
        "rotationStart",
        "rotationEnd",
        "lastVerified"
      ],
      "properties": {
        "title": {"$ref": "#/definitions/label"},
        "locationName": {"$ref": "#/definitions/label"},
        "locationCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,8}$"
        },
        "curatorName": {"$ref": "#/definitions/label"},
        "curatorRole": {"$ref": "#/definitions/label"},
        "rotationStart": {"$ref": "#/definitions/date"},
        "rotationEnd": {"$ref": "#/definitions/date"},
        "lastVerified": {"$ref": "#/definitions/date"}
      }
    },
    "pathItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "ref", "week", "order", "priority", "rationale"],
      "properties": {
        "instanceId": {"$ref": "#/definitions/identifier"},
        "ref": {"$ref": "#/definitions/identifier"},
        "week": {"type": "integer", "minimum": 1},
        "order": {"type": "integer", "minimum": 1},
        "priority": {"$ref": "#/definitions/priority"},
        "rationale": {"$ref": "#/definitions/rationale"}
      }
    },
    "ms3PathItem": {
      "allOf": [
        {"$ref": "#/definitions/pathItem"},
        {"properties": {"week": {"type": "integer", "minimum": 1, "maximum": 6}}}
      ]
    },
    "residentPathItem": {
      "allOf": [
        {"$ref": "#/definitions/pathItem"},
        {"properties": {"week": {"type": "integer", "minimum": 1, "maximum": 4}}}
      ]
    },
    "ms3Resource": {
      "allOf": [
        {"$ref": "#/definitions/resource"},
        {"properties": {"week": {"type": "integer", "minimum": 1, "maximum": 6}}}
      ]
    },
    "residentResource": {
      "allOf": [
        {"$ref": "#/definitions/resource"},
        {"properties": {"week": {"type": "integer", "minimum": 1, "maximum": 4}}}
      ]
    },
    "localOrientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstDayArrival",
        "dailySchedule",
        "roundsWorkflow",
        "presentationExpectations",
        "documentationExpectations",
        "attendanceExpectations",
        "feedbackProcess",
        "accessPreparation",
        "contacts",
        "checklist",
        "resources"
      ],
      "properties": {
        "firstDayArrival": {"$ref": "#/definitions/orientationText"},
        "dailySchedule": {"$ref": "#/definitions/orientationText"},
        "roundsWorkflow": {"$ref": "#/definitions/orientationText"},
        "presentationExpectations": {"$ref": "#/definitions/orientationText"},
        "documentationExpectations": {"$ref": "#/definitions/orientationText"},
        "attendanceExpectations": {"$ref": "#/definitions/orientationText"},
        "feedbackProcess": {"$ref": "#/definitions/orientationText"},
        "accessPreparation": {"$ref": "#/definitions/orientationText"},
        "contacts": {
          "type": "array",
          "items": {"$ref": "#/definitions/contact"}
        },
        "checklist": {
          "type": "array",
          "maxItems": 24,
          "items": {"$ref": "#/definitions/checklistItem"}
        },
        "resources": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/definitions/resource"}
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "directoryUrl"],
      "properties": {
        "role": {"$ref": "#/definitions/label"},
        "directoryUrl": {"$ref": "#/definitions/url"}
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "priority"],
      "properties": {
        "id": {"$ref": "#/definitions/identifier"},
        "label": {"$ref": "#/definitions/label"},
        "priority": {"$ref": "#/definitions/priority"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "priority", "week", "rationale"],
      "properties": {
        "id": {"$ref": "#/definitions/identifier"},
        "title": {"$ref": "#/definitions/label"},
        "url": {"$ref": "#/definitions/url"},
        "priority": {"$ref": "#/definitions/priority"},
        "week": {"type": "integer", "minimum": 1},
        "rationale": {"$ref": "#/definitions/rationale"}
      }
    }
  }
}
