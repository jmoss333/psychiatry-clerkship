{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "shelf_comat_bank_item",
  "description": "Canonical machine-readable schema for the dual-exam (NBME Psychiatry Shelf + NBOME COMAT Clinical Psychiatry) original question bank. STRICT SUPERSET of the repo's question_bank.schema.json item shape: it preserves every field the live SPA renderer, SRS (QBX#<id>), and response records rely on (id/type/category/competency/difficulty/stem/options+trap/why/pearl/evidence/tier2/subtype/hy) and ADDS the dual-exam blueprint mappings, external-evidence references, and richer teaching fields required by the initiative brief. Items authored here remain back-portable into question_bank.json by dropping the added keys (renderers ignore unknown keys). Ids use the qbx_ prefix to avoid any collision with the existing attested qb_ ids. Quality bar: 03_ITEM_WRITING_REVIEW_RUBRIC.md. Blueprint/quotas: 01_BLUEPRINT_CROSSWALK.md.",
  "type": "object",
  "required": ["schema_version", "bank_version", "_note", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "bank_version": { "type": "string", "description": "Human label, e.g. 'pilot-01' or 'v1'." },
    "_note": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "status", "title", "type", "category", "competency",
        "exam_alignment", "blueprint", "learning_objective", "tested_decision",
        "intended_difficulty", "difficulty", "cognitive_process", "clinical_setting",
        "patient_age_group", "pages", "stem", "lead_in", "options", "correct_option",
        "why", "complete_correct_answer_explanation", "explanation_for_each_distractor",
        "pearl", "key_takeaway", "common_reasoning_error", "evidence", "references",
        "reference_access_date", "authoring_batch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^qbx_[a-z]+_[0-9]{3}$",
          "description": "Stable forever. Prefix maps to category (qbx_sud_001). Distinct from live qb_ ids to prevent collisions; Sol/Codex may renumber into qb_ space at integration if desired (do it once, then freeze)."
        },
        "version": { "type": "integer", "minimum": 1, "description": "Item revision counter; 1 at first draft." },
        "status": {
          "type": "string",
          "enum": ["draft", "clinical_review", "faculty_attested", "retired"],
          "description": "Drafting model always writes 'draft'. 'clinical_review' set by internal review pass; 'faculty_attested' set ONLY by Dr. Moss's tooling; 'retired' non-destructive."
        },
        "title": { "type": "string", "description": "Short faculty-navigation label, not shown to learners." },
        "type": { "type": "string", "enum": ["sba", "two-tier", "relational"] },
        "subtype": {
          "type": "string",
          "enum": ["family-system", "what-would-you-say", "transition-of-care"],
          "description": "Relational items only."
        },
        "category": {
          "type": "string",
          "enum": ["mood", "psychosis", "anxiety", "substance", "neurocog", "pharm", "safety", "personality", "childdev", "otherdx", "ethics", "relational"]
        },
        "competency": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "enum": ["dx", "next-step", "management", "safety", "pharm", "psychosocial"] }
        },
        "exam_alignment": {
          "type": "string",
          "enum": ["both", "shelf", "comat"],
          "description": "'both' = shared/core; 'shelf' = NBME-emphasis; 'comat' = COMAT-emphasis."
        },
        "exam_emphasis_note": { "type": "string", "description": "Optional: why this leans shelf or comat." },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nbme", "comat"],
          "properties": {
            "nbme": {
              "type": "object",
              "additionalProperties": false,
              "required": ["system", "physician_task", "site_of_care", "patient_age"],
              "properties": {
                "system": { "type": "string", "enum": ["General Principles", "Behavioral Health", "Nervous System & Special Senses", "Other Systems", "Social Sciences"] },
                "physician_task": { "type": "string", "enum": ["Diagnosis", "Pharmacotherapy/Intervention/Management"] },
                "site_of_care": { "type": "string", "enum": ["Ambulatory", "Emergency Department", "Inpatient"] },
                "patient_age": { "type": "string", "enum": ["Birth to 12", "13 and older"] }
              }
            },
            "comat": {
              "type": "object",
              "additionalProperties": false,
              "required": ["presentation", "physician_task"],
              "properties": {
                "presentation": {
                  "type": "string",
                  "enum": [
                    "Anxiety/Trauma/Dissociative/OCD",
                    "Neurocognitive",
                    "Neurodevelopmental/Gender Dysphoria/Disruptive-Impulse-Conduct",
                    "Depressive/Bipolar/Related",
                    "Personality",
                    "Schizophrenia Spectrum/Psychotic",
                    "Psychiatric Illness due to Medical Condition/Somatic/Sleep-Wake",
                    "Substance-Related/Addictive",
                    "Feeding-Eating-Elimination/Sexual-Paraphilic"
                  ]
                },
                "physician_task": {
                  "type": "string",
                  "enum": ["Health Promotion/Prevention/Care Delivery", "History & Physical (incl. Dx)", "Diagnostic Technologies", "Management", "Scientific Mechanisms of Disease"]
                }
              }
            },
            "osteopathic_competency": {
              "type": "string",
              "description": "Optional; only when genuinely relevant (holistic assessment, social determinants, mind-body, OMM). Never forced."
            }
          }
        },
        "learning_objective": { "type": "string", "description": "What the item teaches, one sentence." },
        "tested_decision": { "type": "string", "description": "The single clinical decision under test (e.g., 'When to begin buprenorphine induction')." },
        "intended_difficulty": { "type": "string", "enum": ["foundational", "standard", "advanced"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3, "description": "Numeric mirror of intended_difficulty (1/2/3) for repo back-port." },
        "cognitive_process": {
          "type": "string",
          "enum": ["recognition", "diagnostic-reasoning", "treatment-selection", "adverse-effect-recognition", "next-step-management", "mechanism", "communication-decision"]
        },
        "clinical_setting": {
          "type": "string",
          "enum": ["ambulatory", "emergency-department", "inpatient", "consultation-liaison"]
        },
        "patient_age_group": {
          "type": "string",
          "enum": ["birth-12", "adolescent-13-17", "adult-18-64", "older-adult-65plus"]
        },
        "hy": { "type": "boolean", "description": "High-yield flag; scarce (<= 1/3 of items)." },
        "pages": {
          "type": "array",
          "minItems": 0,
          "items": { "type": "string", "pattern": "\\.md$" },
          "description": "Library slugs the item aligns with (back-port grounding). May be empty for items grounded solely in external sources; if empty, references[] must carry the grounding."
        },
        "related_lesson_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "path"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "path": { "type": "string" } }
          },
          "description": "Learning-path deep links (?page=<slug>.md or tools/<name>.html)."
        },
        "link": {
          "type": "object",
          "required": ["href"],
          "additionalProperties": false,
          "properties": { "label": { "type": "string" }, "href": { "type": "string" } }
        },
        "stem": { "type": "string", "description": "Clinical vignette; age/setting/timeline/findings; ends in the positive lead_in. Answerable with options covered." },
        "lead_in": { "type": "string", "description": "The positive, focused question. Duplicated as the final sentence of stem for renderer compatibility." },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "t"],
            "properties": {
              "key": { "type": "string", "enum": ["A", "B", "C", "D"] },
              "t": { "type": "string" },
              "c": { "const": true, "description": "Present on exactly one option." },
              "trap": {
                "type": "object",
                "required": ["name", "note"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "description": "Named misconception, 2-6 words, reusable." },
                  "note": { "type": "string", "description": "One line of better thinking." }
                }
              }
            },
            "if": { "not": { "required": ["c"] } },
            "then": { "required": ["trap"] }
          }
        },
        "correct_option": { "type": "string", "enum": ["A", "B", "C", "D"], "description": "Explicit key of the correct option; must match the option carrying c:true." },
        "why": { "type": "string", "description": "Concise repo-style rationale: dispatches traps by name, then states the discriminator." },
        "complete_correct_answer_explanation": { "type": "string", "description": "Fuller teaching explanation of why the correct answer is best, with the reasoning chain." },
        "explanation_for_each_distractor": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-key rationale for why each wrong option is wrong (and the misconception it encodes). Keys present must equal the three non-correct option keys.",
          "properties": {
            "A": { "type": "string" }, "B": { "type": "string" }, "C": { "type": "string" }, "D": { "type": "string" }
          }
        },
        "pearl": { "type": "string", "description": "One keepable line (repo field)." },
        "key_takeaway": { "type": "string", "description": "The single durable point; may equal pearl." },
        "common_reasoning_error": { "type": "string", "description": "The dominant misconception this item is built to surface." },
        "management_or_safety_caveat": { "type": "string", "description": "Escalation/safety/monitoring caveat when relevant (medication, pregnancy, emergency, legal, pediatric)." },
        "evidence": { "type": "string", "description": "Anchor statement — the claim as an authoritative source states it (page or external)." },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["citation", "type"],
            "properties": {
              "citation": { "type": "string", "description": "First author et al., Journal Year;Vol(Issue):Pages. or guideline/label/manual full citation." },
              "type": { "type": "string", "enum": ["guideline", "fda-label", "manual-dsm", "systematic-review", "landmark-trial", "textbook", "primary-study", "library-page"] },
              "url": { "type": "string" },
              "doi": { "type": "string" },
              "pmid": { "type": "string" },
              "access_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "verified": { "type": "boolean", "description": "True if the identifier (PMID/DOI/URL) was confirmed against the source during authoring." },
              "note": { "type": "string" }
            }
          },
          "description": "External authoritative evidence. Never fabricate an identifier. If unverifiable, mark verified:false and add a faculty_review_flag."
        },
        "reference_access_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date the item's evidence was last verified against sources." },
        "faculty_review_flags": {
          "type": "array",
          "items": { "type": "string", "enum": ["medication", "pregnancy", "emergency", "legal-jurisdiction", "pediatric", "higher-intensity-review", "evidence-conflict", "osteopathic-content", "unanchored-claim"] },
          "description": "Higher-intensity review triggers per the brief."
        },
        "content_warning": { "type": "string", "description": "e.g., 'Depicts suicidal ideation.' Present only when warranted." },
        "authoring_batch": { "type": "string", "description": "e.g., 'pilot-01'." },
        "tier2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["q", "options", "why"],
          "description": "Required iff type is 'two-tier'. Options are competing rationales; strong distractor rationales mirror the tier-1 traps.",
          "properties": {
            "q": { "type": "string" },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "t"],
                "properties": {
                  "key": { "type": "string", "enum": ["A", "B", "C", "D"] },
                  "t": { "type": "string" },
                  "c": { "const": true }
                }
              }
            },
            "correct_option": { "type": "string", "enum": ["A", "B", "C", "D"] },
            "why": { "type": "string" }
          }
        },
        "retired": { "type": "boolean" },
        "retiredReason": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "two-tier" } } }, "then": { "required": ["tier2"] } },
        { "if": { "properties": { "type": { "const": "relational" } } }, "then": { "required": ["subtype"] } }
      ]
    }
  }
}
