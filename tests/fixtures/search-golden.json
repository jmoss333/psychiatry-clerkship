{
  "description": "Golden learner queries (C2, 2026-10-17). Each row: on each site, one of `acceptable` must rank within the top `maxRank` of the real search (titles, summaries, aliases, the synonym list and page text together); `before` pages must not outrank it; `minTotal` guards recall. `{site}` in a ref is the site's own case twin (ms3 or res). `track` lists pages a site's search must never return for the listed queries. Run against the BUILT sites by frontdoor-search-gate.mjs (check-static-site.mjs, every build) and against the source projection by tests/search-golden.test.mjs. Before/after numbers for this list are in the C2 PR body. Change a row only with the reason in the same diff.",
  "queries": [
    { "query": "agitation", "sites": { "both": { "acceptable": ["agitation.md"], "maxRank": 1 } } },
    { "query": "lithium level", "sites": { "both": { "acceptable": ["med_monitoring.md"], "maxRank": 1 } } },
    { "query": "catatonia", "sites": { "both": { "acceptable": ["catatonia.md"], "maxRank": 1, "before": ["exp_consult.md"] } } },
    { "query": "catatonia", "sites": { "both": { "acceptable": ["cotw_20260831_catatonia_{site}.md", "bfcrs.html"], "maxRank": 4 } } },
    { "query": "QTc", "sites": { "both": { "acceptable": ["med_monitoring.md", "psychopharm_primer.md", "cl_reference.md"], "maxRank": 2, "minTotal": 6 } } },
    { "query": "QTc", "sites": { "both": { "acceptable": ["med_monitoring.md"], "maxRank": 6 } } },
    { "query": "QT prolongation", "sites": { "both": { "acceptable": ["med_monitoring.md", "psychopharm_primer.md", "cl_reference.md"], "maxRank": 2, "minTotal": 6 } } },
    { "query": "capacity", "sites": { "both": { "acceptable": ["capacity.html"], "maxRank": 1 } } },
    { "query": "NMS", "sites": { "both": { "acceptable": ["toxidromes.md"], "maxRank": 1 } } },
    { "query": "NMS", "sites": { "both": { "acceptable": ["cotw_20260914_ssnms_{site}.md"], "maxRank": 3 } } },
    { "query": "neuroleptic malignant", "sites": { "both": { "acceptable": ["toxidromes.md"], "maxRank": 1, "minTotal": 4 } } },
