    { "query": "first-episode psychosis", "sites": { "both": { "acceptable": ["t_psychosis.md"], "maxRank": 1 } } },
    { "query": "first-episode psychosis", "sites": { "both": { "acceptable": ["cotw_20260907_fep_{site}.md"], "maxRank": 3 } } },
    { "query": "FEP", "sites": { "both": { "acceptable": ["t_psychosis.md", "cotw_20260907_fep_{site}.md"], "maxRank": 2 } } },
    { "query": "decision-making capacity", "sites": { "both": { "acceptable": ["capacity.html"], "maxRank": 1 } } },
    { "query": "CIWA", "sites": { "both": { "acceptable": ["withdrawal.html"], "maxRank": 3 } } },
    { "query": "EPS", "sites": { "both": { "acceptable": ["med_monitoring.md"], "maxRank": 1 } } }
  ],
  "track": {
    "res": {
      "why": "MS3-track pages: the six-week path's week pages (the MS3 learningPaths landingRef) and curriculum.siteLibrary.resident.exclusions. They still open from links on the resident site.",
      "neverReturn": ["orientation.md", "osce.md", "shelf.md", "reading_map.md"],
