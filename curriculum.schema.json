{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "curriculum.json — front door structure",
  "type": "object",
  "required": ["learningPaths", "libraryColumns", "libraryExclude", "siteLibrary", "rightsReferences", "safetyKit", "roles", "synonyms"],
  "additionalProperties": false,
  "properties": {
    "_note": { "type": "string" },
    "learningPaths": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "ms3": {
          "allOf": [
            { "$ref": "#/definitions/learningPath" },
            { "properties": {
              "id": { "const": "ms3-six-week" },
              "weeks": { "minItems": 6, "maxItems": 6 }
            }}
          ]
        },
        "resident": {
          "allOf": [
            { "$ref": "#/definitions/learningPath" },
            { "properties": {
              "id": { "const": "resident-four-week" },
              "weeks": { "minItems": 4, "maxItems": 4 }
            }}
          ]
        }
      }
    },
    "libraryColumns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "accent", "refs"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "accent": { "type": "string", "enum": ["tool", "safety", "topic"] },
          "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "libraryExclude": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "reason"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "siteLibrary": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "ms3": { "$ref": "#/definitions/siteLibraryEntry" },
        "resident": { "$ref": "#/definitions/siteLibraryEntry" }
      }
    },
    "_rightsReferencesNote": { "type": "string" },
    "rightsReferences": {
      "description": "Shipped .html pages that are references ABOUT an instrument the library does not reproduce. Kept in lockstep with instrument_rights.json by validate_curriculum.py.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "safetyKit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "sub", "triggers"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "sub": { "type": "string", "minLength": 1 },
          "triggers": {
            "description": "Crisis vocabulary routing a plain-language query to this protocol. Matched whole-word/phrase against the space-padded raw query, so entries are written the way a learner types them.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2, "pattern": "^[a-z0-9'’ -]+$" }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "ms3": { "$ref": "#/definitions/roleList" },
        "resident": { "$ref": "#/definitions/roleList" }
      }
    },
    "synonyms": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "definitions": {
    "learningPath": {
      "type": "object",
      "required": ["id", "weeks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "weeks": {
          "type": "array",
          "items": { "$ref": "#/definitions/week" }
        }
      }
    },
    "week": {
      "type": "object",
      "required": ["n", "title", "theme", "focusCategories", "items"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 6 },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "focusCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": [
            "anxiety", "childdev", "ethics", "mood", "neurocog", "otherdx",
            "personality", "pharm", "psychosis", "relational", "safety", "substance"
          ] }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/pathItem" }
        }
      }
    },
    "pathItem": {
      "type": "object",
      "required": ["ref", "kind"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["read", "tool"] }
      }
    },
    "siteLibraryEntry": {
      "type": "object",
      "required": ["additions", "exclusions"],
      "additionalProperties": false,
      "properties": {
        "additions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column", "refs"],
            "additionalProperties": false,
            "properties": {
              "column": { "type": "string", "minLength": 1 },
              "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "roleList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "desc"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "desc": { "type": "string", "minLength": 1 },
          "hint": { "type": "string" }
        }
      }
    }
  }
}
