{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "curriculum.json — front door structure",
  "type": "object",
  "required": ["learningPaths", "libraryColumns", "essentials", "libraryExclude", "careResources", "careNavigator", "teachingResources", "siteLibrary", "rightsReferences", "safetyKit", "appPathway", "roles", "synonyms"],
  "additionalProperties": false,
  "properties": {
    "_note": { "type": "string" },
    "learningPaths": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "ms3": {
          "allOf": [
            { "$ref": "#/definitions/learningPath" },
            { "properties": {
              "id": { "const": "ms3-six-week" },
              "weeks": {
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "allOf": [
                    { "$ref": "#/definitions/week" },
                    { "required": ["landingRef"] }
                  ]
                }
              }
            }}
          ]
        },
        "resident": {
          "allOf": [
            { "$ref": "#/definitions/learningPath" },
            { "properties": {
              "id": { "const": "resident-four-week" },
              "weeks": { "minItems": 4, "maxItems": 4 }
            }}
          ]
        }
      }
    },
    "libraryColumns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "accent", "refs"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "accent": { "type": "string", "enum": ["tool", "safety", "topic"] },
          "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "essentials": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "_note": { "type": "string" },
        "ms3": { "$ref": "#/definitions/essentialsSections" },
        "resident": { "$ref": "#/definitions/essentialsSections" }
      }
    },
    "libraryExclude": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "reason"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "careResources": {
      "description": "Canonical external patient-care destinations shown on both sites. Search terms are matched locally and are never appended to the URL.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "group", "title", "description", "url", "searchTerms"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "group": { "type": "string", "enum": ["support", "education"] },
          "title": { "type": "string", "minLength": 8, "maxLength": 64 },
          "description": { "type": "string", "minLength": 12, "maxLength": 120 },
          "url": {
            "type": "string",
            "anyOf": [
              { "pattern": "^https://reconnect-tools\\.netlify\\.app/tools/[a-z0-9-]+\\.html$" },
              { "const": "https://mental-health-education-library.netlify.app/patient" }
            ]
          },
          "searchTerms": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$" }
          }
        }
      }
    },
    "careNavigator": {
      "description": "Fixed, local-only task choices that rank canonical careResources without collecting patient context.",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "label", "explanation", "primaryResourceId", "alternativeResourceIds"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": ["services", "meetings", "explain", "listen", "books", "family-conversation"]
          },
          "label": { "type": "string", "minLength": 8, "maxLength": 64 },
          "explanation": { "type": "string", "minLength": 24, "maxLength": 160 },
          "primaryResourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "alternativeResourceIds": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    },
    "teachingResources": {
      "description": "Curated external teaching companions shown in The Essentials on both sites. They are navigation-only and never enter completion or attestation inventories.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "url", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "const": "family-therapy-companion" },
          "title": { "type": "string", "minLength": 8, "maxLength": 64 },
          "description": { "type": "string", "minLength": 12, "maxLength": 120 },
          "url": { "const": "https://family-therapy-seminar-companion.netlify.app/" },
          "note": { "type": "string", "minLength": 20, "maxLength": 120 }
        }
      }
    },
    "siteLibrary": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "ms3": { "$ref": "#/definitions/siteLibraryEntry" },
        "resident": { "$ref": "#/definitions/siteLibraryEntry" }
      }
    },
    "_rightsReferencesNote": { "type": "string" },
    "rightsReferences": {
      "description": "Shipped .html pages that are references ABOUT an instrument the library does not reproduce. Kept in lockstep with instrument_rights.json by validate_curriculum.py.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "libraryHints": {
      "description": "One audience-neutral line per Library-placed tool ('use this when…'), keyed by ref. validate_curriculum.py requires a line for every column-placed or site-added .html ref and rejects a line for a ref no column places.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_-]+\\.html$" },
      "additionalProperties": { "type": "string", "minLength": 8, "maxLength": 110 }
    },
    "safetyKit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "sub", "triggers"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "sub": { "type": "string", "minLength": 1 },
          "triggers": {
            "description": "Crisis vocabulary routing a plain-language query to this protocol. Matched whole-word/phrase against the space-padded raw query, so entries are written the way a learner types them.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2, "pattern": "^[a-z0-9'’ -]+$" }
          }
        }
      }
    },
    "appPathway": {
      "type": "object",
      "required": ["intro", "bridges", "activities", "practicePacks"],
      "additionalProperties": false,
      "properties": {
        "intro": { "type": "string", "minLength": 1 },
        "bridges": {
          "type": "object",
          "required": ["pa", "pmhnp"],
          "additionalProperties": false,
          "properties": {
            "pa": {
              "allOf": [
                { "$ref": "#/definitions/appBridge" },
                { "properties": { "name": { "const": "PA psychiatry bridge" } } }
              ]
            },
            "pmhnp": {
              "allOf": [
                { "$ref": "#/definitions/appBridge" },
                { "properties": { "name": { "const": "PMHNP medical-systems bridge" } } }
              ]
            }
          }
        },
        "activities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/appActivity" }
        },
        "practicePacks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/appPracticePack" }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["ms3", "resident"],
      "additionalProperties": false,
      "properties": {
        "ms3": { "$ref": "#/definitions/roleList" },
        "resident": { "$ref": "#/definitions/roleList" }
      }
    },
    "searchAliases": {
      "description": "Curated resource-discovery vocabulary; never expands safety triggers.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_-]+\\.(md|html)$" },
      "additionalProperties": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": { "type": "string", "minLength": 2, "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$" }
      }
    },
    "searchExclude": {
      "description": "Explicit exceptions to shipped-resource search coverage; independent of Library placement.",
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "required": ["ref", "reason"], "additionalProperties": false,
        "properties": { "ref": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
      }
    },
    "_synonymsNote": { "type": "string" },
    "synonyms": {
      "description": "Query expansion. A single-word key expands per word. A key CONTAINING A SPACE is a phrase, matched whole-phrase against the raw query — the safe way to express a multi-word intent whose individual words are too common to expand on their own.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9 -]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "essentialsSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/properties/libraryColumns/items" },
          { "properties": { "refs": { "minItems": 1, "uniqueItems": true } } }
        ]
      }
    },
    "learningPath": {
      "type": "object",
      "required": ["id", "weeks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "weeks": {
          "type": "array",
          "items": { "$ref": "#/definitions/week" }
        }
      }
    },
    "week": {
      "type": "object",
      "required": ["n", "title", "theme", "focusCategories", "items"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 6 },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "landingRef": { "type": "string", "minLength": 1 },
        "focusCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": [
            "anxiety", "childdev", "ethics", "mood", "neurocog", "otherdx",
            "personality", "pharm", "psychosis", "relational", "safety", "substance"
          ] }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/pathItem" }
        },
        "practice": {
          "description": "The week's observable practice: one skill to practise, one feedback request to make, and optionally the direct-observation card (WP-3) it maps to. Replaces the hard-coded FD_PATH_PRACTICE rows in frontdoor/fd_path.js, which are {skill, feedback} objects — an object, not a string, so the feedback prompt the Path renders is kept. Optional: no consumer reads it yet.",
          "type": "object",
          "required": ["skill", "feedback"],
          "additionalProperties": false,
          "properties": {
            "skill": { "type": "string", "minLength": 1 },
            "feedback": { "type": "string", "minLength": 1 },
            "card": { "type": "string", "pattern": "^DO-[0-9]+$" }
          }
        }
      }
    },
    "pathItem": {
      "type": "object",
      "required": ["ref", "kind"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["read", "tool"] },
        "priority": {
          "description": "DECISION: required-core-tier (decisions.json). The Required Core tier, in the same three tokens as rotation_edition.schema.json's priority. Absent means recommended: `default` is an annotation only, so validate_curriculum.py applies that meaning, and it holds each week's required items to at most 120 read-minutes from topic_meta.json `read`.",
          "type": "string",
          "enum": ["required", "recommended", "optional"],
          "default": "recommended"
        },
        "window": {
          "description": "The Days 1-3 ward-survival set. validate_curriculum.py allows it only in week 1.",
          "type": "string",
          "enum": ["days-1-3"]
        },
        "query": {
          "description": "One key=value pair forwarded to a tool as a deep link, e.g. case=sp_depression_gated_si_001 or week=3. validate_curriculum.py allows it only on kind 'tool'.",
          "type": "string",
          "pattern": "^[a-z]+=[A-Za-z0-9_-]+$"
        }
      }
    },
    "siteLibraryEntry": {
      "type": "object",
      "required": ["additions", "exclusions"],
      "additionalProperties": false,
      "properties": {
        "additions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column", "refs"],
            "additionalProperties": false,
            "properties": {
              "column": { "type": "string", "minLength": 1 },
              "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "appBridge": {
      "type": "object",
      "required": ["name", "summary", "refs", "selfCheck"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "refs": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "selfCheck": {
          "type": "object",
          "required": ["prompt", "actions"],
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "string", "minLength": 1 },
            "actions": {
              "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
              "items": { "type": "string", "enum": ["revisit", "supervisor", "another"] }
            }
          }
        }
      }
    },
    "appActivity": {
      "type": "object",
      "required": ["id", "name", "practiceId", "purpose", "refs", "actions"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": ["initial-evaluation", "medication-follow-through", "collateral-transition"]
        },
        "practiceId": {
          "type": "string",
          "enum": ["training-briefing", "workshop-equipment-checkout", "community-event-handoff"]
        },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "actions": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "type": "string", "enum": ["prepare", "rehearse", "observe"] }
        }
      }
    },
    "appPracticeText": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "appPracticePack": {
      "type": "object",
      "required": ["id", "title", "snapshot", "change", "statements", "supervisorQuestions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "snapshot": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "change": { "type": "string", "minLength": 1 },
        "statements": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "$ref": "#/definitions/appPracticeText" }
        },
        "supervisorQuestions": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "$ref": "#/definitions/appPracticeText" }
        }
      }
    },
    "roleList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "desc"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "desc": { "type": "string", "minLength": 1 },
          "hint": { "type": "string" }
        }
      }
    }
  }
}
